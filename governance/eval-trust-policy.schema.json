{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-workflow-kit.local/governance/eval-trust-policy.schema.json",
  "title": "Codex Workflow V4.2 Eval Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "keys"],
  "properties": {
    "schema_version": {"const": "4.2"},
    "policy_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "key_sha256", "status"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1},
          "algorithm": {"const": "hmac-sha256"},
          "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["active", "revoked"]}
        }
      }
    }
  }
}
